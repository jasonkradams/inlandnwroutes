{
  "extensions": {
    "front-matter": {
      "enabled": true
    }
  },
  "plugins": {
    "MD013": {
      "enabled": true,
      "line_length": 120,
      "heading_line_length": 120,
      "code_block_line_length": 120
    },
    "MD033": {
      "enabled": true,
      "allowed_elements": "div, span, iframe, p, br, a, img, table, tr, td, th, thead, tbody, input, script, !--"
    },
    "MD041": {
      "enabled": false
    }
  }
}
